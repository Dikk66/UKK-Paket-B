            "url": "{{base_url}}/api/auth/register/admin-space",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"admin_cowork\",\n    \"password\": \"password123\",\n    \"nama_coworking\": \"CoWork Jakarta\",\n    \"nama_pemilik\": \"Ahmad Fauzi\",\n    \"telp\": \"081234567890\",\n    \"alamat\": \"Jl. Sudirman No.1 Jakarta\"\n}"
