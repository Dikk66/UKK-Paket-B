                  "if (res.status === true) {",
                  "    console.log('✅ Admin registered:', res.data.user.username);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-maker-key", "value": "{{app_key}}" }
